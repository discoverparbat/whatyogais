---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE, sectionBySlug, fmtDate } from '../../data/site';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((entry) => ({ params: { section: entry.data.section, slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const section = sectionBySlug(d.section)!;
const url = `${SITE.url}/${d.section}/${entry.id}/`;
const related = all
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => (a.data.section === d.section ? 0 : 1) - (b.data.section === d.section ? 0 : 1) || a.data.order - b.data.order)
  .slice(0, 4);

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, description: d.description,
    datePublished: d.published.toISOString().slice(0, 10), dateModified: d.updated.toISOString().slice(0, 10),
    author: { '@type': 'Person', name: SITE.author, url: `${SITE.url}/about/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url + '/' },
    mainEntityOfPage: url, image: `${SITE.url}/og-image.png`,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: section.name, item: `${SITE.url}/${section.slug}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
  ...(d.faqs.length ? [{
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }] : []),
];
---
<Base title={`${d.title} | ${SITE.name}`} description={d.description} schema={schema} ogType="article">
  <header class="art-head">
    <div class="narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${section.slug}/`}>{section.name}</a></nav>
      {d.dev && <p class="term"><span class="dev" lang="sa">{d.dev}</span>{d.iast && <span class="iast">{d.iast}</span>}</p>}
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="byline">By {SITE.author}, updated {fmtDate(d.updated)}</p>
    </div>
  </header>

  <article class="narrow prose art-body">
    <Content />

    {d.faqs.length > 0 && (
      <section class="faqs">
        <h2>Questions people ask</h2>
        {d.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="sources">
        <h2>Sources and further reading</h2>
        <ul>{d.sources.map((s) => <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.title}</a> : s.title}</li>)}</ul>
      </section>
    )}
  </article>

  <section class="narrow more">
    <h2>Keep reading</h2>
    <ul class="more-list">
      {related.map((r) => (
        <li>
          <a href={`/${r.data.section}/${r.id}/`}>{r.data.title}</a>
          <span class="muted">{sectionBySlug(r.data.section)!.name}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .art-head { background: var(--indigo); color: var(--on-indigo); padding: 48px 0 56px; }
  .art-head h1 { color: #fff; margin-bottom: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 0.92rem; margin-bottom: 28px; }
  .crumbs a { color: var(--on-indigo-muted); text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }
  .crumbs span { color: var(--indigo-2); }
  .term { display: flex; align-items: baseline; gap: 14px; margin: 0 0 10px; }
  .term .dev { font-size: clamp(2rem, 5vw, 2.8rem); color: var(--saffron); line-height: 1.3; }
  .term .iast { color: var(--on-indigo-muted); font-family: var(--display); font-size: 1.15rem; }
  .lede { font-size: 1.2rem; color: var(--on-indigo); max-width: 60ch; margin-bottom: 20px; }
  .byline { font-size: 0.92rem; color: var(--on-indigo-muted); margin: 0; }
  .art-body { padding-top: 48px; }
  .faqs details { border-top: 1px solid var(--line); padding: 14px 0; }
  .faqs details:last-of-type { border-bottom: 1px solid var(--line); }
  .faqs summary { cursor: pointer; font-weight: 600; color: var(--indigo); }
  .faqs details p { margin: 10px 0 0; }
  .sources li { font-size: 0.98rem; }
  .more { margin-top: 64px; }
  .more-list { list-style: none; padding: 0; margin: 0; }
  .more-list li { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--line); }
  .more-list li:last-child { border-bottom: 1px solid var(--line); }
  .more-list a { font-family: var(--display); font-size: 1.2rem; text-decoration: none; }
  .more-list a:hover { text-decoration: underline; }
  .more-list span { font-size: 0.9rem; flex-shrink: 0; }
  @media (max-width: 560px) { .more-list li { flex-direction: column; gap: 2px; } }
</style>
