---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { SITE, sections } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, schema, ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og-image.png', SITE.url).href;
const path = Astro.url.pathname;
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
const year = new Date().getFullYear();
const orgSchema = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: SITE.name, url: SITE.url + '/', logo: SITE.url + '/apple-touch-icon.png',
};
const allSchema = [orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="max-image-preview:large" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1B1838" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Tiro+Devanagari+Sanskrit:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand"><Mark />What Yoga Is</a>
        <nav class="nav" aria-label="Main">
          {sections.map((s) => <a href={`/${s.slug}/`} aria-current={current(`/${s.slug}/`)}>{s.name}</a>)}
          <a href="/about/" aria-current={current('/about/')}>About</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="foot-grid">
          <div>
            <a href="/" class="brand"><Mark />What Yoga Is</a>
            <p style="margin-top:14px;max-width:44ch">{SITE.tagline} Clear, sourced writing on what the yoga tradition actually teaches, from Nepal.</p>
          </div>
          <div>
            <h2>Read</h2>
            <ul>{sections.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}</ul>
          </div>
          <div>
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About this site</a></li>
              <li><a href="/retreats/">Retreats in Nepal</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </div>
        </div>
        <p class="foot-note">Writing on yoga's philosophy and practice for general education. It isn't medical advice: check with a qualified teacher or doctor before starting a new practice, especially breathwork. © {year} {SITE.name}.</p>
      </div>
    </footer>
  </body>
</html>
